{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@zykairotis/ice-ai": ["./packages/ai/src/index.ts"],
			"@zykairotis/ice-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@zykairotis/ice-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@zykairotis/ice-ai/dist/*": ["./packages/ai/src/*"],
			"@zykairotis/ice-agent-core": ["./packages/agent/src/index.ts"],
			"@zykairotis/ice-agent-core/node": ["./packages/agent/src/node.ts"],
			"@zykairotis/ice-agent-core/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@zykairotis/ice-agent-core/*": ["./packages/agent/src/*"],
			"@zykairotis/ice-storage-sqlite-node": ["./packages/storage/sqlite-node/src/index.ts"],
			"@zykairotis/ice-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@zykairotis/ice-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@zykairotis/ice-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@zykairotis/ice-protocol": ["./packages/protocol/src/index.ts"],
			"@zykairotis/ice-protocol/*": ["./packages/protocol/src/*"],
			"@zykairotis/ice-client": ["./packages/client/src/index.ts"],
			"@zykairotis/ice-client/*": ["./packages/client/src/*"],
			"@zykairotis/ice-server": ["./packages/server/src/index.ts"],
			"@zykairotis/ice-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@zykairotis/ice-tui": ["./packages/tui/src/index.ts"],
			"@zykairotis/ice-tui/*": ["./packages/tui/src/*"],
			"@zykairotis/ice-agent-old": ["./packages/agent-old/src/index.ts"],
			"@zykairotis/ice-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/storage/*/src/**/*", "packages/storage/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
